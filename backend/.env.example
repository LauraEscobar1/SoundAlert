# Copia este archivo a .env (cp .env.example .env) y rellena los valores.
# .env está en .gitignore: NUNCA lo subas al repositorio.

PORT=3000

# --- Base de datos (Supabase) ---
# Supabase Dashboard → Project Settings → API
#   SUPABASE_URL              = "Project URL"   (https://<ref>.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY = clave "service_role" (o "secret key" sb_secret_...)
# La service role key ignora RLS: SOLO en este backend, NUNCA en el reloj ni en una app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional, solo para el test que comprueba que la clave pública no puede leer datos.
SUPABASE_ANON_KEY=
# "supabase" (por defecto). "memory" existe solo para los tests automáticos.
DB_PROVIDER=supabase

# --- Autenticación (opcional) ---
# Si se define, todas las rutas salvo /health exigen la cabecera x-api-key.
API_KEY=

# --- IA / Clasificador ---
# mock = provisional, sin IA (usa simulatedLabel) | remote = servicio HTTP con el modelo
CLASSIFIER_PROVIDER=mock
CLASSIFIER_REMOTE_URL=
CLASSIFIER_REMOTE_API_KEY=
CLASSIFIER_TIMEOUT_MS=5000

# --- Alertas ---
MIN_CONFIDENCE=0.6
ALERT_COOLDOWN_SECONDS=10
MAX_AUDIO_BYTES=2097152
